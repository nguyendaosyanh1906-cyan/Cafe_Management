<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" style="-fx-background-color: #f4f6f9; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.cafeshopmanagement.controller.AdminOrderController">

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Lịch sử Hóa đơn &amp; Thanh toán" />

    <HBox spacing="10">
        <Button onAction="#handleRefresh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Làm mới (Refresh)" />
    </HBox>

    <TableView fx:id="tableOrders" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px;">
        <columns>
            <TableColumn fx:id="colOrderId" prefWidth="70.0" text="Mã HĐ" />
            <TableColumn fx:id="colDate" prefWidth="150.0" text="Ngày tạo" />
            <TableColumn fx:id="colStaff" prefWidth="150.0" text="Nhân viên (Thu ngân)" />
            <TableColumn fx:id="colCustomer" prefWidth="150.0" text="Khách hàng" />
            <TableColumn fx:id="colTotal" prefWidth="120.0" text="Tổng tiền" />
            <TableColumn fx:id="colPayment" prefWidth="100.0" text="Thanh toán" />
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
        </columns>
    </TableView>

</VBox>