<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.cafeshopmanagement.controller.CheckoutConfirmController">

    <Label text="XÁC NHẬN HÓA ĐƠN" textFill="#2c3e50">
        <font><Font name="System Bold" size="22.0" /></font>
    </Label>

    <!-- Khu vực hiển thị chi tiết giống bill in ra giấy -->
    <TextArea fx:id="txtInvoiceDetail" editable="false" prefHeight="300.0" prefWidth="400.0" style="-fx-font-family: 'Consolas'; -fx-font-size: 14px;" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Label text="Tổng thanh toán:">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <Label fx:id="lblTotalAmount" text="0 VNĐ" textFill="#e74c3c">
            <font><Font name="System Bold" size="20.0" /></font>
        </Label>
    </HBox>

    <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 0 0;">
        <Button cancelButton="true" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold;" text="HỦY BỎ" />
        <Button defaultButton="true" onAction="#handleConfirm" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="XÁC NHẬN THANH TOÁN" />
    </HBox>
</VBox>