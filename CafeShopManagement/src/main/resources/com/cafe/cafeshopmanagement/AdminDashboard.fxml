<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cafe.cafeshopmanagement.controller.AdminDashboardController">
    <left>
        <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <Label text="ADMIN PANEL" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <Button fx:id="btnManageProducts" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleManageProducts" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white;" text="Quản lý Sản phẩm &amp; Topping" />
                <Button fx:id="btnManageStaff" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleManageStaff" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white;" text="Quản lý Nhân viên &amp; Khách" />
                <Button fx:id="btnOrderHistory" maxWidth="Infinity" onAction="#handleOrderHistory" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-padding: 10;" text="Lịch sử hóa đơn" />
                <Button fx:id="btnDashboard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDashboard" prefHeight="40.0" style="-fx-background-color: #34495e; -fx-text-fill: white;" text="Thống kê Doanh thu" />
                <Button fx:id="btnPOS" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGoToPOS" prefHeight="40.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="Trang Bán Hàng (POS)" />

                <VBox VBox.vgrow="ALWAYS" />

                <Button fx:id="btnLogout" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" prefHeight="35.0" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="Đăng xuất" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox fx:id="mainContent" alignment="CENTER" spacing="15.0" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
            <children>
                <Label text="CHÀO MỪNG QUẢN TRỊ VIÊN">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Vui lòng chọn chức năng từ menu bên trái để bắt đầu." textFill="#7f8c8d" />
            </children>
        </VBox>
    </center>
</BorderPane>